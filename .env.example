# Seule variable requise par le POC.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Optionnel : modèle Stagehand (défaut : anthropic/claude-sonnet-4-6)
# STAGEHAND_MODEL=anthropic/claude-sonnet-4-6

# Optionnel : requête de recherche YouTube (défaut : POE2)
# YOUTUBE_QUERY=POE2

# NE PAS définir BROWSERBASE_API_KEY ni BROWSERBASE_PROJECT_ID.
